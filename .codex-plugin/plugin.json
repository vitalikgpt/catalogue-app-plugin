{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "catalogue-app",
  "version": "1.0.0",
  "description": "Create Telegram bots in one click without BotFather or a server, make emoji and sticker packs, and search Telegram channels, chats, bots and mini apps. Includes a Telegram Bot API knowledge base.",
  "author": {
    "name": "Catalogue App",
    "url": "https://t.me/catalogue_app"
  },
  "homepage": "https://gramnews.org/studio",
  "repository": "https://github.com/vitalikgpt/catalogue-app-plugin",
  "license": "MIT",
  "keywords": [
    "telegram",
    "telegram-bot",
    "emoji",
    "stickers",
    "mini-apps"
  ],
  "skills": "./skills/",
  "mcpServers": "./mcp.json",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Catalogue App for Telegram",
        "shortDescription": "One-click Telegram bots",
        "category": "Productivity",
        "websiteURL": "https://gramnews.org/studio",
        "supportURL": "https://t.me/catalogue_app",
        "privacyPolicyURL": "https://gramnews.org/privacy",
        "termsOfServiceURL": "https://gramnews.org/terms",
        "composerIcon": "./assets/icon-128.png",
        "logo": "./assets/icon-512.png"
      }
    }
  }
}